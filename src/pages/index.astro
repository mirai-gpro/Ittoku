---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Plan from '../components/Plan.astro';
import Menu from '../components/Menu.astro';
import Drinks from '../components/Drinks.astro';
import SNS from '../components/SNS.astro';
import Booking from '../components/Booking.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Ginza Ittoku | 銀座一徳"
  description="A private cultural lounge in Ginza, Tokyo. ¥300M imperial interior. ¥33,000/person. Open 20:00–24:00."
>
  <Navbar />
  <Hero />
  <Story />
  <Gallery />
  <Plan />
  <Menu />
  <Drinks />
  <SNS />
  <Booking />
  <Location />
  <Footer />
</Layout>

<script>
  // Language
  function setLang(l: string) {
    document.body.setAttribute('data-lang', l);
    document.documentElement.lang = l === 'ja' ? 'ja' : 'en';
    document.getElementById('bEn')?.classList.toggle('on', l === 'en');
    document.getElementById('bJa')?.classList.toggle('on', l === 'ja');
  }

  // Language toggle buttons
  document.querySelectorAll('[data-lang-switch]').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).getAttribute('data-lang-switch') || 'en';
      setLang(lang);
    });
  });

  // Scrolled nav
  const navEl = document.getElementById('nav');
  window.addEventListener('scroll', () => navEl?.classList.toggle('on', scrollY > 60), { passive: true });

  // Fade on scroll (IntersectionObserver)
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade').forEach(el => io.observe(el));
</script>
