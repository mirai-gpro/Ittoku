---
const testimonials = [
  {
    text: "\"I've traveled to 47 countries and experienced luxury dining worldwide. Ginza Ittoku was the most authentic cultural experience I've ever had. The ¥33,000 felt like a bargain for what we received.\"",
    author: 'Michael R. — California, USA',
    role: 'Business Executive',
  },
  {
    text: "\"We hosted our most important clients here. They still talk about it months later. The privacy, the culture, and the warmth of the hosts created an atmosphere unlike anywhere else in Tokyo.\"",
    author: 'David L. — Singapore',
    role: 'Private Equity Partner',
  },
  {
    text: "\"Better than any museum. You don't just observe Japanese culture — you live it for an evening. The kimono-clad hosts were knowledgeable, gracious, and made us feel completely at home.\"",
    author: 'Sophie M. — Paris, France',
    role: 'Art Historian',
  },
  {
    text: "\"As a gay traveler, finding a luxury space in Tokyo where I genuinely felt celebrated — not just tolerated — was extraordinary. Ittoku is a rare gem that I recommend to everyone I know.\"",
    author: 'James T. — London, UK',
    role: 'Creative Director',
  },
  {
    text: '"完美的文化体验。我们从上海来东京，这是整个旅行的亮点。服务完美，环境令人难以置信，值得每一分钱。下次来东京一定再来。"',
    author: 'Wang Wei — Shanghai, China',
    role: 'Entrepreneur',
  },
];
---

<section id="testimonials">
  <div class="section-inner">
    <div class="testimonials-header fade-in">
      <span class="section-label" data-en="Guest Voices" data-ja="ゲストの声">Guest Voices</span>
      <h2 class="section-title" data-en="What Our Guests Say" data-ja="ゲストからのメッセージ">What Our Guests Say</h2>
    </div>
    <div class="testimonials-overflow fade-in delay-1">
      <div class="testimonials-track" id="testimonialTrack">
        {testimonials.map((t) => (
          <div class="testimonial-card">
            <span class="testimonial-stars">★★★★★</span>
            <p class="testimonial-text">{t.text}</p>
            <div class="testimonial-author">{t.author}</div>
            <span class="testimonial-role">{t.role}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="slider-controls fade-in">
      <button class="slider-btn" data-slide-dir="-1">←</button>
      <div class="slider-dots" id="sliderDots"></div>
      <button class="slider-btn" data-slide-dir="1">→</button>
    </div>
  </div>
</section>

<style>
  #testimonials { background: var(--black); padding: 9rem 0; overflow: hidden; }
  .testimonials-header { text-align: center; margin-bottom: 4rem; }
  .testimonials-overflow { overflow: hidden; }
  .testimonials-track { display: flex; gap: 2rem; transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1); }
  .testimonial-card {
    flex-shrink: 0; width: calc(50% - 1rem);
    background: var(--dark-mid); padding: 3rem;
  }
  .testimonial-stars { color: var(--gold); letter-spacing: 0.18em; margin-bottom: 1.5rem; display: block; }
  .testimonial-text {
    font-family: var(--font-serif);
    font-size: 1.1rem; color: rgba(255,255,255,0.82);
    line-height: 1.85; margin-bottom: 2rem; font-style: italic;
  }
  .testimonial-author { font-size: 0.82rem; color: var(--gold); font-family: var(--font-sans); letter-spacing: 0.08em; }
  .testimonial-role { font-size: 0.75rem; color: rgba(255,255,255,0.35); margin-top: 0.2rem; display: block; font-family: var(--font-sans); }
  .slider-controls { display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 3rem; }
  .slider-btn {
    background: none;
    border: 1px solid rgba(255,255,255,0.18); color: white;
    width: 46px; height: 46px; cursor: pointer;
    font-size: 1.1rem; transition: all var(--transition);
    display: flex; align-items: center; justify-content: center;
  }
  .slider-btn:hover { border-color: var(--gold); color: var(--gold); }
  .slider-dots { display: flex; gap: 0.5rem; align-items: center; }
  :global(.dot) { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.2); cursor: pointer; transition: all var(--transition); }
  :global(.dot.active) { background: var(--gold); width: 20px; border-radius: 3px; }
  @media (max-width: 768px) {
    #testimonials { padding: 5.5rem 0; }
    .testimonial-card { width: calc(85vw); }
  }
</style>
