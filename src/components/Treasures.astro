---
const treasures = [
  {
    img: '/images/instagram/tiger_leopard_painting.jpg',
    alt: 'Kano School Tiger and Leopard Paintings — recreated from Nagoya Castle',
    titleEn: 'Kano School Tiger Paintings',
    titleJa: '狩野派の虎図',
    descEn: "Originally adorned Nagoya Castle's Audience Chamber (1615). Our replicas were created by the same artisan lineage. Symbols of power in feudal Japan.",
    descJa: '名古屋城の大広間を飾っていた（1615年）。原本を修復する職人の系譜によって制作された、封建時代の権力の象徴。',
  },
  {
    img: '/images/instagram/nio_statue.jpg',
    alt: 'Guardian deity Nio statue — Kongorikishi',
    imgStyle: 'object-position: center top;',
    titleEn: 'Naoe Kanetsugu Samurai Armor',
    titleJa: '直江兼続の甲冑',
    descEn: "Sengoku period general (1560–1619), famous for his '愛' (Love) helmet ornament. Museum-quality craftsmanship representing one of history's most philosophical samurai.",
    descJa: '戦国武将・直江兼続（1560〜1619）。「愛」の前立てで名高い、史上最も哲学的な武将を体現した博物館級の甲冑。',
  },
  {
    img: '/images/instagram/kiriko_ceiling.jpg',
    alt: 'Edo Kiriko glass ceiling art — imperial palace craftsmanship',
    titleEn: 'Imperial Ceiling Art',
    titleJa: '天井絵',
    descEn: "Peony blossoms symbolizing prosperity and honor. Hand-painted using traditional pigments inspired by Nijo Castle's imperial chambers.",
    descJa: '繁栄と誉れを象徴する牡丹の花。二条城の御殿を手本に、伝統的な顔料で丹念に描かれた天井絵。',
  },
  {
    img: '/images/instagram/hero_interior.jpg',
    alt: 'Interior of Ginza Ittoku showing lacquer floors and imperial decor',
    titleEn: 'Kinkaku-ji Master Lacquer Floors',
    titleJa: '金閣寺の匠による漆の床',
    descEn: "Created by artisans who maintain Kyoto's Golden Pavilion. Months of hand-polishing create a mirror-like finish reflecting 400 years of technique.",
    descJa: '金閣寺を手がける職人による作品。幾ヶ月もの手磨きが生む鏡のような光沢には、400年の技が宿ります。',
  },
  {
    img: '/images/instagram/vip_room_gold_entrance.jpg',
    alt: 'Gold leaf fusuma doors — HORIKIN craftsmanship since 1711',
    titleEn: 'HORIKIN Gold Leaf Fusuma (Est. 1711)',
    titleJa: '堀金箔粉の金箔襖（1711年創業）',
    descEn: "Each gold leaf individually applied by hand. HORIKIN has adorned imperial palaces and Kyoto temples for over 300 years. No two panels are identical.",
    descJa: '一枚一枚、職人の手で張られた金箔。堀金箔粉は300年以上にわたり御所や京都の寺院を飾ってきました。二度と同じ文様はありません。',
  },
];
---

<section id="treasures">
  <div class="section-inner">
    <div class="treasures-header fade-in">
      <span class="section-label" data-en="Cultural Heritage" data-ja="文化的遺産">Cultural Heritage</span>
      <h2 class="section-title" data-en="Treasures Worth ¥300 Million" data-ja="3億円の文化的宝物">Treasures Worth ¥300 Million</h2>
      <p class="section-subtitle" data-en="Each piece was created by master artisans whose lineages have preserved Japan's most sacred cultural sites for generations." data-ja="空間を彩るひとつひとつは、日本の最も神聖な文化財を幾世代にもわたり守り続けてきた匠の職人たちが手がけた作品です。">Each piece was created by master artisans whose lineages have preserved Japan's most sacred cultural sites for generations.</p>
    </div>
    <div class="treasure-cards fade-in delay-1">
      {treasures.map((t) => (
        <div class="treasure-card">
          <img
            class="treasure-card-img"
            src={t.img}
            alt={t.alt}
            loading="lazy"
            style={t.imgStyle || ''}
          />
          <div class="treasure-card-body">
            <h3 data-en={t.titleEn} data-ja={t.titleJa}>{t.titleEn}</h3>
            <p data-en={t.descEn} data-ja={t.descJa}>{t.descEn}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #treasures { background: var(--black); padding: 9rem 0; }
  .treasures-header { text-align: center; margin-bottom: 5rem; }
  .treasures-header .section-subtitle { margin: 0 auto; }
  .treasure-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 2px;
  }
  .treasure-card {
    background: var(--dark-mid);
    padding: 0;
    border-top: 2px solid transparent;
    transition: all var(--transition);
    overflow: hidden;
  }
  .treasure-card:hover { border-top-color: var(--gold); background: #242424; }
  .treasure-card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
    filter: brightness(0.9);
  }
  .treasure-card:hover .treasure-card-img { transform: scale(1.04); filter: brightness(1.0); }
  .treasure-card-body { padding: 2rem; }
  .treasure-card h3 {
    font-size: 1.2rem; color: var(--gold);
    margin-bottom: 0.85rem; font-weight: 400;
  }
  .treasure-card p {
    font-size: 0.9rem; color: rgba(255,255,255,0.55);
    line-height: 1.8; font-family: var(--font-sans); font-weight: 300;
  }
  @media (max-width: 768px) {
    #treasures { padding: 5.5rem 0; }
  }
</style>
